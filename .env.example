GEMINI_API_KEY=your_new_gemini_key_here
PRIMARY_MODEL=gemini-3.8-flash
VERIFIER_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=120000
REQUEST_TIMEOUT_SECONDS=60
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_RETRIES=1
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_PAGE_FETCH_LIMIT=3
WEB_PAGE_TIMEOUT_SECONDS=5
WEB_PAGE_MAX_BYTES=1000000
WEB_PAGE_MAX_REDIRECTS=3
WEB_PAGE_MAX_TEXT_CHARS=12000
DATABASE_URL=sqlite:///./hallucination_detector.db
HISTORY_AUTH_REQUIRED=false
KNOWLEDGE_BASE_PATH=app/vector_db/default_knowledge_base.jsonl
